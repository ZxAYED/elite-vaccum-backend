model ServiceOrder {
  id                   String                      @id @default(uuid()) @db.Uuid
  businessId           String                      @unique @map("business_id") @db.VarChar(50)
  serviceRequestId     String                      @unique @map("service_request_id") @db.Uuid
  quotationId          String?                     @map("quotation_id") @db.Uuid
  customerId           String                      @map("customer_id") @db.Uuid
  assignedTechnicianId String?                     @map("assigned_technician_id") @db.Uuid
  serviceAddressId     String?                     @map("service_address_id") @db.Uuid
  status               ServiceOrderStatus          @default(SCHEDULED)
  scheduledAt          DateTime                    @map("scheduled_at") @db.Timestamptz(6)
  estimatedDurationMin Int                         @default(60) @map("estimated_duration_min")
  totalUsd             Decimal                     @map("total_usd") @db.Decimal(10, 2)
  summary              String
  customerNotes        String?                     @map("customer_notes")
  adminInstructions    String?                     @map("admin_instructions")
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments         Appointment[]
  reviews              CustomerReview[]
  invoices             Invoice[]
  quotation            Quotation?                  @relation("ServiceOrderQuotation")
  statusHistory        ServiceOrderStatusHistory[]
  technician           Technician?                 @relation("TechnicianAssignedJobs", fields: [assignedTechnicianId], references: [id])
  customer             Customer                    @relation(fields: [customerId], references: [id])
  addressRef           CustomerAddress?            @relation("ServiceOrderAddress", fields: [serviceAddressId], references: [id])
  serviceRequest       ServiceRequest              @relation(fields: [serviceRequestId], references: [id])
  etas                 TechnicianEta[]
  serviceReport        TechnicianServiceReport?

  @@index([customerId, status])
  @@index([assignedTechnicianId, scheduledAt])
  @@index([quotationId])
  @@map("service_orders")
}

model ServiceOrderStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  serviceOrderId String             @map("service_order_id") @db.Uuid
  fromStatus     ServiceOrderStatus @map("from_status")
  toStatus       ServiceOrderStatus @map("to_status")
  note           String?
  actorLabel     String             @map("actor_label") @db.VarChar(100)
  changedAt      DateTime           @default(now()) @map("changed_at") @db.Timestamptz(6)
  serviceOrder   ServiceOrder       @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId, changedAt])
  @@map("service_order_status_history")
}

model Appointment {
  id               String          @id @default(uuid()) @db.Uuid
  serviceOrderId   String?         @map("service_order_id") @db.Uuid
  serviceRequestId String?         @map("service_request_id") @db.Uuid
  technicianId     String?         @map("technician_id") @db.Uuid
  status           String          @default("CONFIRMED") @db.VarChar(50)
  startAt          DateTime        @map("start_at") @db.Timestamptz(6)
  endAt            DateTime        @map("end_at") @db.Timestamptz(6)
  addressSnapshot  Json            @map("address_snapshot")
  notes            String?
  adminNote        String?         @map("admin_note")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  serviceOrder     ServiceOrder?   @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  technician       Technician?     @relation(fields: [technicianId], references: [id])

  @@index([technicianId, startAt])
  @@index([serviceRequestId])
  @@index([serviceOrderId])
  @@map("appointments")
}
