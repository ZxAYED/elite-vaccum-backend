model Invoice {
  id               String            @id @default(uuid()) @db.Uuid
  businessId       String            @unique @map("business_id") @db.VarChar(50)
  customerId       String            @map("customer_id") @db.Uuid
  productOrderId   String?           @map("product_order_id") @db.Uuid
  serviceOrderId   String?           @map("service_order_id") @db.Uuid
  quotationId      String?           @map("quotation_id") @db.Uuid
  status           InvoiceStatus     @default(ISSUED)
  issueDate        DateTime          @default(now()) @map("issue_date") @db.Timestamptz(6)
  dueDate          DateTime          @map("due_date") @db.Timestamptz(6)
  paidAt           DateTime?         @map("paid_at") @db.Timestamptz(6)
  subtotalUsd      Decimal           @map("subtotal_usd") @db.Decimal(10, 2)
  taxUsd           Decimal           @default(0.00) @map("tax_usd") @db.Decimal(10, 2)
  discountUsd      Decimal           @default(0.00) @map("discount_usd") @db.Decimal(10, 2)
  totalUsd         Decimal           @map("total_usd") @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  serviceRequestId String?           @map("service_request_id") @db.Uuid
  lineItems        InvoiceLineItem[]
  customer         Customer          @relation(fields: [customerId], references: [id])
  productOrder     ProductOrder?     @relation(fields: [productOrderId], references: [id])
  quotation        Quotation?        @relation(fields: [quotationId], references: [id])
  serviceOrder     ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  serviceRequest   ServiceRequest?   @relation(fields: [serviceRequestId], references: [id])
  payments         Payment[]
  refunds          Refund[]

  @@index([customerId, status])
  @@index([status, dueDate])
  @@index([serviceRequestId])
  @@index([productOrderId])
  @@index([serviceOrderId])
  @@index([quotationId])
  @@map("invoices")
}

model InvoiceLineItem {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  description  String   @db.VarChar(255)
  quantity     Int      @default(1)
  unitPriceUsd Decimal  @map("unit_price_usd") @db.Decimal(10, 2)
  totalUsd     Decimal  @map("total_usd") @db.Decimal(10, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_line_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  invoiceId            String        @map("invoice_id") @db.Uuid
  customerId           String        @map("customer_id") @db.Uuid
  amountUsd            Decimal       @map("amount_usd") @db.Decimal(10, 2)
  status               PaymentStatus @default(PENDING)
  methodLabel          String        @map("method_label") @db.VarChar(50)
  transactionReference String?       @unique @map("transaction_reference") @db.VarChar(255)
  technicianPayoutUsd  Decimal?      @map("technician_payout_usd") @db.Decimal(10, 2)
  platformFeeUsd       Decimal?      @map("platform_fee_usd") @db.Decimal(10, 2)
  processedAt          DateTime      @default(now()) @map("processed_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer             Customer      @relation(fields: [customerId], references: [id])
  invoice              Invoice       @relation(fields: [invoiceId], references: [id])
  refunds              Refund[]

  @@index([customerId])
  @@index([invoiceId])
  @@map("payments")
}

model Refund {
  id                   String   @id @default(uuid()) @db.Uuid
  paymentId            String   @map("payment_id") @db.Uuid
  invoiceId            String   @map("invoice_id") @db.Uuid
  amountUsd            Decimal  @map("amount_usd") @db.Decimal(10, 2)
  status               String   @default("COMPLETED") @db.VarChar(50)
  reason               String
  processedAt          DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  transactionReference String?  @unique @map("transaction_reference") @db.VarChar(255)
  invoice              Invoice  @relation(fields: [invoiceId], references: [id])
  payment              Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("refunds")
}
