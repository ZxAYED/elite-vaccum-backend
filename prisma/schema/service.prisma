model ServiceCategory {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?          @db.Text
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  serviceTypes ServiceType[]
  requests    ServiceRequest[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model ServiceType {
  id                String           @id @default(uuid())
  serviceCategoryId String
  serviceCategory   ServiceCategory  @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  name              String
  slug              String
  description       String?          @db.Text
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  requests          ServiceRequest[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([serviceCategoryId, slug])
  @@unique([serviceCategoryId, name])
  @@index([serviceCategoryId])
  @@index([isActive])
  @@index([sortOrder])
}

model ServiceRequest {
  id                 String               @id @default(uuid())
  requestNumber      String               @unique
  customerId         String
  customer           User                 @relation("ServiceRequestsByCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  serviceCategoryId  String
  serviceCategory    ServiceCategory      @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  serviceTypeId      String
  serviceType        ServiceType          @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  addressId          String?
  serviceAddress     Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  customerMachineId  String?
  customerMachine    CustomerMachine?     @relation(fields: [customerMachineId], references: [id], onDelete: SetNull)
  status             ServiceRequestStatus @default(SUBMITTED)
  serviceLocationText String?
  preferredDate      DateTime?
  preferredTime      String?
  problemDescription String               @db.Text
  additionalNotes    String?              @db.Text
  previousMachineInfo String?             @db.Text
  adminInternalNote  String?              @db.Text
  latestQuotedAmount Decimal?             @db.Decimal(10, 2)
  quotationAcceptedAt DateTime?
  quotationRejectedAt DateTime?
  scheduledAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?

  media             ServiceRequestMedia[]
  equipmentSnapshot ServiceEquipmentSnapshot?
  quotations        ServiceQuotation[]
  schedules         ServiceSchedule[]
  payments          ServicePayment[]
  visits            ServiceVisit[]
  completion        ServiceCompletion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([serviceCategoryId])
  @@index([serviceTypeId])
  @@index([status])
  @@index([preferredDate])
  @@index([customerMachineId])
}

model ServiceRequestMedia {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  type             MediaType
  url              String
  objectKey        String?
  fileName         String?
  mimeType         String?
  size             Int?
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
  @@index([type])
}

model CustomerMachine {
  id                 String                          @id @default(uuid())
  customerId         String
  customer           User                            @relation("MachineOwner", fields: [customerId], references: [id], onDelete: Cascade)
  installedAddressId String?
  installedAddress   Address?                        @relation("MachineInstalledAddress", fields: [installedAddressId], references: [id], onDelete: SetNull)
  label              String?
  equipmentType      String?
  manufacturer       String?
  model              String?
  serialNumber       String?
  condition          String?
  notes              String?                         @db.Text
  isActive           Boolean                         @default(true)

  serviceRequests    ServiceRequest[]
  floorPorts         CustomerMachineFloorPort[]
  additionalFeatures CustomerMachineAdditionalFeature[]
  mainUnits          CustomerMachineMainUnit[]
  equipmentSnapshots ServiceEquipmentSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([installedAddressId])
  @@index([serialNumber])
  @@index([isActive])
}

model CustomerMachineFloorPort {
  id                String          @id @default(uuid())
  customerMachineId String
  customerMachine   CustomerMachine @relation(fields: [customerMachineId], references: [id], onDelete: Cascade)
  floorType         FloorType
  portType          PortType
  quantity          Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerMachineId, floorType, portType])
  @@index([customerMachineId])
}

model CustomerMachineAdditionalFeature {
  id                String                @id @default(uuid())
  customerMachineId String
  customerMachine   CustomerMachine       @relation(fields: [customerMachineId], references: [id], onDelete: Cascade)
  featureType       AdditionalFeatureType
  quantity          Int                   @default(0)
  location          String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([customerMachineId])
  @@index([featureType])
}

model CustomerMachineMainUnit {
  id                String          @id @default(uuid())
  customerMachineId String
  customerMachine   CustomerMachine @relation(fields: [customerMachineId], references: [id], onDelete: Cascade)
  unitNumber        Int
  manufacturer      String?
  model             String?
  serialNumber      String?
  location          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerMachineId, unitNumber])
  @@index([customerMachineId])
}

model ServiceEquipmentSnapshot {
  id                         String                           @id @default(uuid())
  serviceRequestId           String                           @unique
  serviceRequest             ServiceRequest                   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  customerMachineId          String?
  customerMachine            CustomerMachine?                 @relation(fields: [customerMachineId], references: [id], onDelete: SetNull)
  equipmentType              String?
  manufacturer               String?
  model                      String?
  serialNumber               String?
  condition                  String?
  problemSymptoms            String?                          @db.Text
  previousRepairHistory      String?                          @db.Text
  previousCustomerMachineInfo String?                         @db.Text
  notes                      String?                          @db.Text

  floorPorts         ServiceEquipmentFloorPort[]
  additionalFeatures ServiceEquipmentAdditionalFeature[]
  mainUnits          ServiceEquipmentMainUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerMachineId])
}

model ServiceEquipmentFloorPort {
  id           String                   @id @default(uuid())
  snapshotId   String
  snapshot     ServiceEquipmentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  floorType    FloorType
  portType     PortType
  quantity     Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([snapshotId, floorType, portType])
  @@index([snapshotId])
}

model ServiceEquipmentAdditionalFeature {
  id           String                   @id @default(uuid())
  snapshotId   String
  snapshot     ServiceEquipmentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  featureType  AdditionalFeatureType
  quantity     Int                      @default(0)
  location     String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([snapshotId])
  @@index([featureType])
}

model ServiceEquipmentMainUnit {
  id           String                   @id @default(uuid())
  snapshotId   String
  snapshot     ServiceEquipmentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  unitNumber   Int
  manufacturer String?
  model        String?
  serialNumber String?
  location     String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([snapshotId, unitNumber])
  @@index([snapshotId])
}

model ServiceQuotation {
  id                    String              @id @default(uuid())
  serviceRequestId      String
  serviceRequest        ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  version               Int
  status                QuotationStatus     @default(DRAFT)
  pdfUrl                String?
  subtotalAmount        Decimal             @db.Decimal(10, 2)
  taxAmount             Decimal             @default(0) @db.Decimal(10, 2)
  discountAmount        Decimal             @default(0) @db.Decimal(10, 2)
  finalAmount           Decimal             @db.Decimal(10, 2)
  termsAndNotes         String?             @db.Text
  validForHours         Int                 @default(24)
  sentAt                DateTime?
  viewedAt              DateTime?
  respondedAt           DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?             @db.Text
  termsAcceptedAt       DateTime?
  supersedesQuotationId String?
  supersedesQuotation   ServiceQuotation?   @relation("QuotationRevision", fields: [supersedesQuotationId], references: [id], onDelete: SetNull)
  revisions             ServiceQuotation[]  @relation("QuotationRevision")
  createdById           String?
  createdBy             User?               @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?
  updatedBy             User?               @relation("QuotationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  lineItems ServiceQuotationLineItem[]
  payments  ServicePayment[]
  schedules ServiceSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceRequestId, version])
  @@index([serviceRequestId])
  @@index([status])
  @@index([validForHours])
}

model ServiceQuotationLineItem {
  id          String              @id @default(uuid())
  quotationId String
  quotation   ServiceQuotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  lineType    QuotationLineType   @default(OTHER)
  description String
  quantity    Int                 @default(1)
  unitPrice   Decimal             @db.Decimal(10, 2)
  lineTotal   Decimal             @db.Decimal(10, 2)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([quotationId])
  @@index([sortOrder])
}

model ServiceSchedule {
  id                     String           @id @default(uuid())
  serviceRequestId       String
  serviceRequest         ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  quotationId            String?
  quotation              ServiceQuotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  assignedTechnicianId   String?
  assignedTechnician     User?            @relation("ScheduleAssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  status                 ScheduleStatus   @default(PENDING)
  scheduledStart         DateTime
  scheduledEnd           DateTime?
  estimatedDurationMinutes Int?
  serviceAddressSnapshot Json?
  customerNote           String?          @db.Text
  internalNote           String?          @db.Text
  cancelReason           String?          @db.Text
  createdById            String?
  createdBy              User?            @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?
  updatedBy              User?            @relation("ScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  visits ServiceVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([quotationId])
  @@index([assignedTechnicianId])
  @@index([status])
  @@index([scheduledStart])
}

model ServicePayment {
  id                  String                 @id @default(uuid())
  serviceRequestId    String
  serviceRequest      ServiceRequest         @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  quotationId         String?
  quotation           ServiceQuotation?      @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  provider            PaymentProvider        @default(STRIPE)
  eventType           PaymentEventType
  status              PaymentLifecycleStatus @default(PENDING)
  paymentIntentId     String?
  chargeId            String?
  authorizationAmount Decimal?               @db.Decimal(10, 2)
  capturedAmount      Decimal?               @db.Decimal(10, 2)
  refundedAmount      Decimal?               @default(0) @db.Decimal(10, 2)
  currency            String                 @default("USD")
  stripePayload       Json?
  processedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([serviceRequestId])
  @@index([quotationId])
  @@index([status])
  @@index([paymentIntentId])
}

model ServiceVisit {
  id                    String                  @id @default(uuid())
  serviceRequestId      String
  serviceRequest        ServiceRequest          @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  scheduleId            String?
  schedule              ServiceSchedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  technicianId          String?
  technician            User?                   @relation("VisitTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  outcome               TechnicianVisitOutcome?
  startedAt             DateTime?
  endedAt               DateTime?
  workSummary           String?                 @db.Text
  partsNeeded           String?                 @db.Text
  followUpRecommendation String?                @db.Text

  media     ServiceVisitMedia[]
  partsUsed ServicePartUsed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId])
  @@index([scheduleId])
  @@index([technicianId])
}

model ServiceVisitMedia {
  id             String       @id @default(uuid())
  visitId        String
  visit          ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  type           MediaType
  url            String
  objectKey      String?
  fileName       String?
  mimeType       String?
  size           Int?
  createdAt      DateTime     @default(now())

  @@index([visitId])
  @@index([type])
}

model ServicePartUsed {
  id         String       @id @default(uuid())
  visitId    String
  visit      ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  partName   String
  quantity   Int          @default(1)
  unitCost   Decimal?     @db.Decimal(10, 2)
  totalCost  Decimal?     @db.Decimal(10, 2)
  note       String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([visitId])
}

model ServiceCompletion {
  id                    String         @id @default(uuid())
  serviceRequestId      String         @unique
  serviceRequest        ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  completedByAdminId    String?
  completedByAdmin      User?          @relation("ServiceCompletionAdmin", fields: [completedByAdminId], references: [id], onDelete: SetNull)
  repairSummary         String?        @db.Text
  completionNotes       String?        @db.Text
  finalAmount           Decimal?       @db.Decimal(10, 2)
  warrantyNote          String?        @db.Text
  followUpRecommendation String?       @db.Text
  completedAt           DateTime       @default(now())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([completedByAdminId])
}
