model Service {
  id              String                  @id @default(uuid()) @db.Uuid
  slug            String                  @unique @db.VarChar(100)
  name            String                  @db.VarChar(150)
  category        String                  @db.VarChar(100)
  description     String
  basePriceUsd    Decimal?                @map("base_price_usd") @db.Decimal(10, 2)
  status          ServiceCatalogStatus    @default(ACTIVE)
  commonIssues    String[]                @default([]) @map("common_issues")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  reviews         CustomerReview[]
  publicOfferings PublicServiceOffering[]
  quotations      Quotation[]
  serviceRequests ServiceRequest[]

  @@map("services")
}

model PublicServiceOffering {
  id          String       @id @default(uuid()) @db.Uuid
  serviceId   String       @map("service_id") @db.Uuid
  slug        String       @unique @db.VarChar(100)
  group       ServiceGroup
  title       String       @db.VarChar(150)
  summary     String
  description String?
  iconKey     String       @map("icon_key") @db.VarChar(50)
  imageUrl    String?      @map("image_url") @db.VarChar(500)
  status      String       @default("ACTIVE") @db.VarChar(50)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([group, sortOrder])
  @@map("public_service_offerings")
}

model ServiceRequest {
  id                   String                     @id @default(uuid()) @db.Uuid
  businessId           String                     @unique @map("business_id") @db.VarChar(50)
  customerId           String                     @map("customer_id") @db.Uuid
  serviceId            String                     @map("service_id") @db.Uuid
  propertyId           String?                    @map("property_id") @db.Uuid
  assignedTechnicianId String?                    @map("assigned_technician_id") @db.Uuid
  title                String                     @db.VarChar(200)
  description          String
  status               ServiceRequestStatus       @default(SUBMITTED)
  urgency              RequestUrgency             @default(MEDIUM)
  symptoms             RequestSymptom[]           @default([])
  preferredDate        String                     @map("preferred_date") @db.VarChar(50)
  preferredTime        String                     @map("preferred_time") @db.VarChar(50)
  propertyLabel        String                     @map("property_label") @db.VarChar(100)
  serviceAddress       Json                       @map("service_address")
  requestedSchedule    Json                       @map("requested_schedule")
  currentSchedule      Json?                      @map("current_schedule")
  estimatedAmountUsd   Decimal?                   @map("estimated_amount_usd") @db.Decimal(10, 2)
  problemLocation      String?                    @map("problem_location") @db.VarChar(150)
  additionalNotes      String?                    @map("additional_notes")
  submittedAt          DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments         Appointment[]
  invoices             Invoice[]
  quotations           Quotation[]
  serviceOrder         ServiceOrder?
  attachments          ServiceRequestAttachment[]
  equipment            ServiceRequestEquipment?
  rejectionHistory     ServiceRequestRejection[]
  assignedTechnician   Technician?                @relation("TechnicianServiceRequests", fields: [assignedTechnicianId], references: [id])
  customer             Customer                   @relation(fields: [customerId], references: [id])
  property             CustomerProperty?          @relation(fields: [propertyId], references: [id])
  service              Service                    @relation(fields: [serviceId], references: [id])

  @@index([customerId, status])
  @@index([status, submittedAt])
  @@index([assignedTechnicianId, status])
  @@index([serviceId])
  @@map("service_requests")
}

model ServiceRequestEquipment {
  id               String         @id @default(uuid()) @db.Uuid
  serviceRequestId String         @unique @map("service_request_id") @db.Uuid
  manufacturer     String?        @db.VarChar(100)
  modelNumber      String?        @map("model_number") @db.VarChar(100)
  serialNumber     String?        @map("serial_number") @db.VarChar(100)
  unitLocation     String?        @map("unit_location") @db.VarChar(100)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@map("service_request_equipment")
}

model ServiceRequestAttachment {
  id               String         @id @default(uuid()) @db.Uuid
  serviceRequestId String         @map("service_request_id") @db.Uuid
  fileName         String         @map("file_name") @db.VarChar(255)
  fileType         String         @map("file_type") @db.VarChar(100)
  sizeBytes        Int            @map("size_bytes")
  url              String         @db.VarChar(500)
  kind             AttachmentKind
  category         String?        @db.VarChar(100)
  note             String?
  uploadedAt       DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@map("service_request_attachments")
}

model ServiceRequestRejection {
  id               String         @id @default(uuid()) @db.Uuid
  serviceRequestId String         @map("service_request_id") @db.Uuid
  reason           String         @db.VarChar(255)
  comments         String?
  actorLabel       String         @map("actor_label") @db.VarChar(100)
  rejectedAt       DateTime       @default(now()) @map("rejected_at") @db.Timestamptz(6)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@map("service_request_rejections")
}
