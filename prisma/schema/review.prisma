model CustomerReview {
  id                String                    @id @default(uuid()) @db.Uuid
  type              ReviewType
  status            ReviewStatus              @default(PENDING)
  customerId        String                    @map("customer_id") @db.Uuid
  customerName      String                    @map("customer_name") @db.VarChar(150)
  productOrderId    String?                   @map("product_order_id") @db.Uuid
  serviceOrderId    String?                   @map("service_order_id") @db.Uuid
  productId         String?                   @map("product_id") @db.Uuid
  serviceId         String?                   @map("service_id") @db.Uuid
  rating            Int
  title             String                    @db.VarChar(200)
  body              String
  preview           String?                   @db.VarChar(255)
  submittedAt       DateTime                  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  publishedAt       DateTime?                 @map("published_at") @db.Timestamptz(6)
  hiddenAt          DateTime?                 @map("hidden_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer          Customer                  @relation(fields: [customerId], references: [id])
  product           Product?                  @relation(fields: [productId], references: [id])
  productOrder      ProductOrder?             @relation(fields: [productOrderId], references: [id])
  service           Service?                  @relation(fields: [serviceId], references: [id])
  serviceOrder      ServiceOrder?             @relation(fields: [serviceOrderId], references: [id])
  moderationHistory ReviewModerationHistory[]

  @@index([type, status])
  @@index([customerId])
  @@index([productId, status])
  @@index([serviceId, status])
  @@map("customer_reviews")
}

model ReviewModerationHistory {
  id         String                 @id @default(uuid()) @db.Uuid
  reviewId   String                 @map("review_id") @db.Uuid
  action     ReviewModerationAction
  reason     String?                @db.VarChar(255)
  note       String?
  actorLabel String                 @map("actor_label") @db.VarChar(100)
  actorId    String?                @map("actor_id") @db.Uuid
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  review     CustomerReview         @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_moderation_history")
}
