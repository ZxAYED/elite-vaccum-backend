// ==========================================
// 3. CUSTOMER DOMAIN & SYSTEM PROFILES
// ==========================================

model Customer {
  id                     String         @id @default(uuid()) @db.Uuid
  userId                 String?        @unique @map("user_id") @db.Uuid
  displayName            String         @map("display_name") @db.VarChar(200)
  firstName              String         @map("first_name") @db.VarChar(100)
  lastName               String         @map("last_name") @db.VarChar(100)
  email                  String         @db.VarChar(255)
  phone                  String         @db.VarChar(30)
  cellphone              String?        @db.VarChar(30)
  company                String?        @db.VarChar(150)
  status                 CustomerStatus @default(ACTIVE)
  totalOrders            Int            @default(0) @map("total_orders")
  lifetimeValueUsd       Decimal        @default(0.00) @map("lifetime_value_usd") @db.Decimal(12, 2)
  primaryAddressId       String?        @map("primary_address_id") @db.Uuid
  preferredContactMethod ContactMethod? @default(EMAIL) @map("preferred_contact_method")
  bestContactTime        String?        @map("best_contact_time") @db.VarChar(100)
  customerPreferences    Json?          @map("customer_preferences")
  internalNotesSummary   String?        @map("internal_notes_summary") @db.Text
  joinedAt               DateTime       @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  primaryAddress  CustomerAddress?       @relation("PrimaryCustomerAddress", fields: [primaryAddressId], references: [id], onDelete: SetNull)
  addresses       CustomerAddress[]      @relation("CustomerAddresses")
  internalNotes   CustomerInternalNote[]
  properties      CustomerProperty[]
  serviceRequests ServiceRequest[]
  quotations      Quotation[]
  serviceOrders   ServiceOrder[]
  productOrders   ProductOrder[]
  carts           Cart[]
  invoices        Invoice[]
  payments        Payment[]
  reviews         CustomerReview[]

  @@index([email])
  @@index([status])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String   @db.VarChar(50) // Home, Billing, Warehouse, etc.
  line1      String   @db.VarChar(255)
  line2      String?  @db.VarChar(255)
  city       String   @db.VarChar(100)
  state      String   @db.VarChar(50)
  postalCode String   @map("postal_code") @db.VarChar(20)
  country    String   @default("USA") @db.VarChar(50)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer              Customer           @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade)
  primaryForCustomer    Customer[]         @relation("PrimaryCustomerAddress")
  properties            CustomerProperty[]
  serviceOrdersServiced ServiceOrder[]     @relation("ServiceOrderAddress")
  productOrdersShipped  ProductOrder[]     @relation("ProductOrderShippingAddress")

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerInternalNote {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  title       String   @db.VarChar(200)
  body        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("NoteAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_internal_notes")
}

model CustomerProperty {
  id                String       @id @default(uuid()) @db.Uuid
  customerId        String       @map("customer_id") @db.Uuid
  addressId         String?      @map("address_id") @db.Uuid
  label             String       @db.VarChar(100) // e.g. "Main Residence", "Beach House"
  propertyType      PropertyType @default(RESIDENTIAL_SINGLE_FAMILY) @map("property_type")
  floors            Int          @default(1)
  hasBasement       Boolean      @default(false) @map("has_basement")
  hasSubBasement    Boolean      @default(false) @map("has_sub_basement")
  accessInformation String?      @map("access_information") @db.Text
  internalNotes     String?      @map("internal_notes") @db.Text
  status            String       @default("ACTIVE") @db.VarChar(50)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  customer           Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address            CustomerAddress?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  vacuumUnits        CustomerPropertyVacuumUnit[]
  inletFloors        CustomerPropertyInletFloor[]
  additionalFeatures CustomerPropertyFeature[]
  serviceRequests    ServiceRequest[]

  @@index([customerId])
  @@map("customer_properties")
}

model CustomerPropertyVacuumUnit {
  id           String          @id @default(uuid()) @db.Uuid
  propertyId   String          @map("property_id") @db.Uuid
  unitNumber   String          @map("unit_number") @db.VarChar(50)
  manufacturer String          @db.VarChar(100)
  model        String          @db.VarChar(100)
  serialNumber String?         @map("serial_number") @db.VarChar(100)
  location     String          @db.VarChar(100) // Garage, Basement, Utility Room
  status       EquipmentStatus @default(OPERATIONAL)
  notes        String?         @db.Text
  installedAt  DateTime?       @map("installed_at") @db.Timestamptz
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  property CustomerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("customer_property_vacuum_units")
}

model CustomerPropertyInletFloor {
  id             String   @id @default(uuid()) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  label          String   @db.VarChar(50) // Ground Floor, 2nd Floor, Basement
  hdh            Int      @default(0) // Hide-A-Hose count
  chameleon      Int      @default(0) // Chameleon count
  chameleonElite Int      @default(0) @map("chameleon_elite")
  standard       Int      @default(0) // Standard inlet count
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  property CustomerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("customer_property_inlet_floors")
}

model CustomerPropertyFeature {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  type       String   @db.VarChar(100) // VacPan, WallyFlex, Drawer Vac, etc.
  quantity   Int      @default(1)
  locations  String[] @default([]) // Kitchen, Master Bath, Mudroom
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  property CustomerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("customer_property_features")
}
