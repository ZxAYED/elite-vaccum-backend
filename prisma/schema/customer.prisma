model Customer {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String?                @unique @map("user_id") @db.Uuid
  displayName            String                 @map("display_name") @db.VarChar(200)
  firstName              String                 @map("first_name") @db.VarChar(100)
  lastName               String                 @map("last_name") @db.VarChar(100)
  email                  String                 @db.VarChar(255)
  phone                  String                 @db.VarChar(30)
  cellphone              String?                @db.VarChar(30)
  company                String?                @db.VarChar(150)
  status                 CustomerStatus         @default(ACTIVE)
  totalOrders            Int                    @default(0) @map("total_orders")
  lifetimeValueUsd       Decimal                @default(0.00) @map("lifetime_value_usd") @db.Decimal(12, 2)
  primaryAddressId       String?                @map("primary_address_id") @db.Uuid
  preferredContactMethod ContactMethod?         @default(EMAIL) @map("preferred_contact_method")
  bestContactTime        String?                @map("best_contact_time") @db.VarChar(100)
  customerPreferences    Json?                  @map("customer_preferences")
  internalNotesSummary   String?                @map("internal_notes_summary")
  joinedAt               DateTime               @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  carts                  Cart[]
  addresses              CustomerAddress[]      @relation("CustomerAddresses")
  internalNotes          CustomerInternalNote[]
  properties             CustomerProperty[]
  reviews                CustomerReview[]
  primaryAddress         CustomerAddress?       @relation("PrimaryCustomerAddress", fields: [primaryAddressId], references: [id])
  user                   User?                  @relation(fields: [userId], references: [id])
  invoices               Invoice[]
  payments               Payment[]
  productOrders          ProductOrder[]
  quotations             Quotation[]
  serviceOrders          ServiceOrder[]
  serviceRequests        ServiceRequest[]

  @@index([email])
  @@index([status])
  @@map("customers")
}

model CustomerAddress {
  id                    String             @id @default(uuid()) @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  label                 String             @db.VarChar(50)
  line1                 String             @db.VarChar(255)
  line2                 String?            @db.VarChar(255)
  city                  String             @db.VarChar(100)
  state                 String             @db.VarChar(50)
  postalCode            String             @map("postal_code") @db.VarChar(20)
  country               String             @default("USA") @db.VarChar(50)
  isDefault             Boolean            @default(false) @map("is_default")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer              Customer           @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade)
  properties            CustomerProperty[]
  primaryForCustomer    Customer[]         @relation("PrimaryCustomerAddress")
  productOrdersShipped  ProductOrder[]     @relation("ProductOrderShippingAddress")
  serviceOrdersServiced ServiceOrder[]     @relation("ServiceOrderAddress")

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerInternalNote {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  title       String   @db.VarChar(200)
  body        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   User     @relation("NoteAuthor", fields: [createdById], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_internal_notes")
}

model CustomerProperty {
  id                 String                       @id @default(uuid()) @db.Uuid
  customerId         String                       @map("customer_id") @db.Uuid
  addressId          String?                      @map("address_id") @db.Uuid
  label              String                       @db.VarChar(100)
  propertyType       PropertyType                 @default(RESIDENTIAL_SINGLE_FAMILY) @map("property_type")
  floors             Int                          @default(1)
  hasBasement        Boolean                      @default(false) @map("has_basement")
  hasSubBasement     Boolean                      @default(false) @map("has_sub_basement")
  accessInformation  String?                      @map("access_information")
  internalNotes      String?                      @map("internal_notes")
  status             String                       @default("ACTIVE") @db.VarChar(50)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  address            CustomerAddress?             @relation(fields: [addressId], references: [id])
  customer           Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  additionalFeatures CustomerPropertyFeature[]
  inletFloors        CustomerPropertyInletFloor[]
  vacuumUnits        CustomerPropertyVacuumUnit[]
  serviceRequests    ServiceRequest[]

  @@index([customerId])
  @@map("customer_properties")
}

model CustomerPropertyVacuumUnit {
  id           String           @id @default(uuid()) @db.Uuid
  propertyId   String           @map("property_id") @db.Uuid
  unitNumber   String           @map("unit_number") @db.VarChar(50)
  manufacturer String           @db.VarChar(100)
  model        String           @db.VarChar(100)
  serialNumber String?          @map("serial_number") @db.VarChar(100)
  location     String           @db.VarChar(100)
  status       EquipmentStatus  @default(OPERATIONAL)
  notes        String?
  installedAt  DateTime?        @map("installed_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  property     CustomerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("customer_property_vacuum_units")
}

model CustomerPropertyInletFloor {
  id             String           @id @default(uuid()) @db.Uuid
  propertyId     String           @map("property_id") @db.Uuid
  label          String           @db.VarChar(50)
  hdh            Int              @default(0)
  chameleon      Int              @default(0)
  chameleonElite Int              @default(0) @map("chameleon_elite")
  standard       Int              @default(0)
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       CustomerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("customer_property_inlet_floors")
}

model CustomerPropertyFeature {
  id         String           @id @default(uuid()) @db.Uuid
  propertyId String           @map("property_id") @db.Uuid
  type       String           @db.VarChar(100)
  quantity   Int              @default(1)
  locations  String[]         @default([])
  notes      String?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  property   CustomerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("customer_property_features")
}
