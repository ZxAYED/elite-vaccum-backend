// ==========================================
// 13. SYSTEM, CONTACT & SETTINGS
// ==========================================

model ContactSubmission {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(150)
  email         String   @db.VarChar(255)
  phone         String   @db.VarChar(30)
  category      String   @db.VarChar(100)
  message       String   @db.Text
  status        String   @default("NEW") @db.VarChar(50) // NEW, IN_REVIEW, RESOLVED
  responseNotes String?  @map("response_notes") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("contact_submissions")
}

model FileUpload {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique @db.VarChar(255)
  fileName   String   @map("file_name") @db.VarChar(255)
  fileType   String   @map("file_type") @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  url        String   @db.VarChar(500)
  provider   String   @default("S3") @db.VarChar(50)
  purpose    String   @db.VarChar(100) // PRODUCT_IMAGE, SERVICE_ATTACHMENT, REPORT_EVIDENCE
  uploaderId String?  @map("uploader_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([purpose])
  @@map("file_uploads")
}

model AdminSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  category    String   @db.VarChar(100) // GENERAL, NOTIFICATIONS, SYSTEM, LEGAL, CONTACT
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([category])
  @@map("admin_settings")
}

model BusinessProfile {
  id              String   @id @default(uuid()) @db.Uuid
  businessName    String   @default("Elite Central Vacuum") @map("business_name") @db.VarChar(150)
  supportEmail    String   @default("zzayediqbalofficial@gmail.com") @map("support_email") @db.VarChar(255)
  primaryPhone    String   @default("01902320296") @map("primary_phone") @db.VarChar(50)
  secondaryPhone  String?  @map("secondary_phone") @db.VarChar(50)
  address         String   @default("123 Elite Plaza, Wellness Drive") @db.VarChar(255)
  city            String   @default("Greenwich") @db.VarChar(100)
  state           String   @default("CT") @db.VarChar(50)
  zipCode         String   @default("06830") @map("zip_code") @db.VarChar(20)
  country         String   @default("United States") @db.VarChar(100)
  coverageMessage String?  @default("Service coverage available by request.") @map("coverage_message") @db.Text
  coverageNotes   String?  @map("coverage_notes") @db.Text
  operatingHours  Json?    @map("operating_hours")
  socialLinks     Json?    @map("social_links")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("business_profiles")
}

model SystemFaq {
  id        String   @id @default(uuid()) @db.Uuid
  question  String   @db.VarChar(300)
  answer    String   @db.Text
  category  String   @default("General") @db.VarChar(100)
  status    String   @default("Published") @db.VarChar(50) // Published, Draft
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([category, status])
  @@map("system_faqs")
}

model LegalPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(100) // terms, privacy, return-policy, warranty
  title       String   @db.VarChar(200) // Terms of Service, Privacy Policy
  content     String   @db.Text
  status      String   @default("Published") @db.VarChar(50) // Published, Draft
  lastUpdated DateTime @default(now()) @map("last_updated") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("legal_policies")
}

