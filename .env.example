# ==========================================
# DATABASE & SERVER
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/elite_vacuum?schema=public"
PORT=3000

# ==========================================
# AUTH & JWT
# ==========================================
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="15m"
REFRESH_JWT_SECRET="your-refresh-jwt-secret-key"
REFRESH_JWT_EXPIRES_IN="30d"
OTP_EXPIRES_MINUTES="10"

# ==========================================
# AWS SES (EMAIL SERVICE)
# ==========================================
AWS_SES_REGION="us-east-1"
AWS_SES_SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
AWS_SES_SMTP_PORT="587"
AWS_SES_SMTP_USER=""
AWS_SES_SMTP_PASS=""
AWS_SES_FROM_EMAIL="support@elitecentralvac.com"

# ==========================================
# AWS S3 (FILE STORAGE)
# ==========================================
AWS_S3_ACCESS_KEY=""
AWS_S3_SECRET_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_REGION="us-east-1"
AWS_S3_URL=""

# ==========================================
# STRIPE PAYMENTS (STORE & SERVICE INVOICES)
# ==========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="usd"

# ==========================================
# GOOGLE GEMINI AI
# ==========================================
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.7-flash"
