# ==========================================
# DATABASE & SERVER
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/elite_vacuum?schema=public"
PORT=3000

# ==========================================
# REDIS (CACHING, PUBSUB, PRESENCE, BULLMQ)
# ==========================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
# Optional: Full URL for Upstash or Managed Redis (e.g. rediss://default:token@host:6379)
# REDIS_URL="redis://localhost:6379/0"
REDIS_KEY_PREFIX="elite_vacuum:"

# ==========================================
# AUTH & JWT
# ==========================================
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="15m"
REFRESH_JWT_SECRET="your-refresh-jwt-secret-key"
REFRESH_JWT_EXPIRES_IN="30d"
OTP_EXPIRES_MINUTES="10"

# ==========================================
# NODEMAILER SMTP EMAIL CONFIGURATION
