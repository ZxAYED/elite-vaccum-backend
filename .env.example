# ==========================================
# DATABASE & SERVER
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/elite_vacuum?schema=public"
PORT=3000

# ==========================================
# AUTH & JWT
# ==========================================
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="15m"
REFRESH_JWT_SECRET="your-refresh-jwt-secret-key"
REFRESH_JWT_EXPIRES_IN="30d"
OTP_EXPIRES_MINUTES="10"

# ==========================================
# NODEMAILER SMTP EMAIL CONFIGURATION
# (Supports Gmail, Brevo, Mailtrap, AWS SES, etc.)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM_EMAIL="Elite Central Vacuum <your-email@gmail.com>"

# ==========================================
# AWS S3 (FILE STORAGE)
# ==========================================
AWS_S3_ACCESS_KEY=""
AWS_S3_SECRET_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_REGION="us-east-1"
AWS_S3_URL=""

# ==========================================
# STRIPE PAYMENTS (STORE & SERVICE INVOICES)
# ==========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="usd"

# ==========================================
# GOOGLE GEMINI AI
# ==========================================
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.6-flash"
