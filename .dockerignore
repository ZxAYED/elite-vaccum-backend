# ── build output & deps (rebuilt inside the image) ──
node_modules
dist
coverage
*.tsbuildinfo

# ── secrets: never bake these into a layer ──
.env
.env.*
!.env.example

# ── vcs / editor / ci ──
.git
.gitignore
.github
.vscode
.idea
.gemini
.claude

# ── docker itself ──
Dockerfile*
compose.yaml
docker-compose*.yml
.dockerignore

# ── tests, scripts & docs not needed at runtime ──
test
scripts
docs
*.md
!README.md

# ── noise ──
*.log
npm-debug.log*
repomix-output.xml
Dockerfile.zip
uploads
tmp
